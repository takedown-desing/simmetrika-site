---
import { u } from '../lib/site.mjs';
const { data = {}, crumbs = [], children: _c } = Astro.props;
const cta = data.hero_cta || {};
const esc = (s) => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/"/g, '&quot;');
const btn = (b, cls) => !b?.label || (!b.href && b.action !== 'callback') ? '' : b.action === 'callback' ? `<button type="button" class="btn ${cls}" data-callback>${esc(b.label)}</button>` : `<a class="btn ${cls}" href="${esc(u(b.href))}">${esc(b.label)}</a>`;
---
<div class="phead"><div class="wrap">
  {crumbs.length > 0 && <ol class="crumbs">{crumbs.map((c, i) => <li>{i < crumbs.length - 1 ? <a href={u(c.url)}>{c.name}</a> : <span aria-current="page">{c.name}</span>}</li>)}</ol>}
  {data.eyebrow && <p class="eyebrow">{data.eyebrow}</p>}
  <h1>{data.h1}</h1>
  {data.lede && <p class="lede">{data.lede}</p>}
  {data.highlights?.length > 0 && <div class="hl">{data.highlights.map((h) => <div><b>{h.value}</b><span>{h.label}</span></div>)}</div>}
  {(btn(cta.primary, '') || btn(cta.secondary, '')) && <div class="phead-btns" set:html={btn(cta.primary, 'btn-accent') + btn(cta.secondary, 'btn-line')} />}
  <slot />
</div></div>
