---
import { u, NAV, NAV_RIGHT, CATALOG_MENU } from '../lib/site.mjs';
import { settings } from '../lib/catalog.mjs';
const { home = false, current } = Astro.props;
const tel = 'tel:' + settings.phone_main.replace(/[^\d+]/g, '');
---
<header class={`hdr ${home ? 'hdr-home' : ''}`}>
  <div class="wrap hdr-in">
    <div class="hdr-l">
      <button class="hdr-cat" type="button" data-menu aria-expanded="false" aria-controls="cmenu">
        <span class="round" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 8h14M5 12h14M5 16h14" stroke="currentColor" stroke-width="1.6"/></svg></span>
        <span class="hdr-cat-l">Каталог<br>товаров</span><span class="sr">Открыть каталог</span>
      </button>
      <nav class="hdr-nav" aria-label="Основное меню">
        {NAV.map((n) => <a href={u(n.url)} class={n.accent ? 'is-accent' : ''} aria-current={current === n.url ? 'page' : undefined}>{n.title}</a>)}
      </nav>
    </div>
    <a class="logo" href={u('/')} aria-label="SIMMETRIKA, на главную"><b>SIMME<i>T</i>RIKA</b><span>мебельная фабрика</span></a>
    <div class="hdr-r">
      <nav class="hdr-nav" aria-label="Покупателям">
        {NAV_RIGHT.map((n) => <a href={u(n.url)} aria-current={current === n.url ? 'page' : undefined}>{n.title}</a>)}
      </nav>
      <a class="hdr-phone" href={tel}><b>{settings.phone_main}</b><span>ежедневно {settings.work_hours_calls}</span></a>
      <a class="round hdr-mob" href={tel} aria-label={`Позвонить ${settings.phone_main}`}><svg viewBox="0 0 24 24"><path d="M6.6 3.5l3 .4 1.2 4-2 1.6a12 12 0 0 0 5.7 5.7l1.6-2 4 1.2.4 3c-.1 1-1 1.8-2 1.8A16.5 16.5 0 0 1 4.8 5.5c0-1 .8-1.9 1.8-2z" fill="none" stroke="currentColor" stroke-width="1.5"/></svg></a>
      <a class="round" href={u('/zayavka/')} aria-label="Заявка"><svg viewBox="0 0 24 24"><path d="M3 4h2.5l2.2 10.5h10.6L20.5 7H7" fill="none" stroke="currentColor" stroke-width="1.5"/><circle cx="9.5" cy="19" r="1.5" fill="currentColor"/><circle cx="17" cy="19" r="1.5" fill="currentColor"/></svg><span class="cart-n" data-cart-n data-n="0"></span></a>
    </div>
  </div>
</header>
<div class="cmenu" id="cmenu" data-cmenu>
  <div class="cmenu-in"><div class="wrap">
    <div class="cmenu-top"><a class="logo" href={u('/')}><b>SIMME<i>T</i>RIKA</b><span>мебельная фабрика</span></a><button class="round" type="button" data-menu-close aria-label="Закрыть каталог"><svg viewBox="0 0 24 24"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2"/></svg></button></div>
    <div class="cmenu-grid">
      {CATALOG_MENU.map((g) => <div><p>{g.title}</p><ul>{g.items.map((i) => <li><a href={u(i.url)}>{i.title}</a></li>)}</ul></div>)}
    </div>
  </div></div>
</div>
