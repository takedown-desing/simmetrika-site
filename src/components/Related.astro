---
import { u } from '../lib/site.mjs';
const items = (Astro.props.items || []).filter((r) => r?.url && r?.title);
---
{items.length > 0 && <section class="rel" aria-labelledby="rel-t"><div class="wrap">
  <h2 class="sec-title" id="rel-t">Смотрите также</h2>
  <div class="rel-grid">{items.map((r) => <a class="rel-i" href={u(r.url)}><b>{r.title}</b><span>{r.text}</span></a>)}</div>
</div></section>}
