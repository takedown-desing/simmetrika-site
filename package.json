{
  "name": "simmetrika-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "cms:config": "node scripts/gen-cms-config.mjs",
    "validate": "node scripts/gen-cms-config.mjs && node scripts/validate-cms.mjs",
    "images": "node scripts/build-images.mjs",
    "dev": "node scripts/gen-cms-config.mjs && astro dev",
    "prebuild": "node scripts/gen-cms-config.mjs && node scripts/validate-cms.mjs --quiet",
    "build": "astro build",
    "postbuild": "node scripts/save-cms-state.mjs && node scripts/validate-cms.mjs --quiet --report",
    "preview": "astro preview",
    "qa": "node scripts/qa-dist.mjs",
    "test:admin": "node scripts/test-admin.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.3.8",
    "js-yaml": "^5.4.3",
    "rehype-raw": "^7.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-directive": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "sharp": "^0.35.5",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1"
  }
}
